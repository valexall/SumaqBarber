PORT=4000
JWT_SECRET="your_super_secret_jwt_key_here"

# Conexión a Supabase (PostgreSQL)
# DATABASE_URL se usa para la conexión mediante pgbouncer o la conexión transaccional recomendada
DATABASE_URL="postgres://[db-user]:[db-password]@aws-0-us-west-1.pooler.supabase.com:6543/[db-name]?pgbouncer=true&connection_limit=1"

# DIRECT_URL se usa para las migraciones de esquema
DIRECT_URL="postgres://[db-user]:[db-password]@aws-0-us-west-1.pooler.supabase.com:5432/[db-name]"
